<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>

    <!--
      This project is intentionally NOT part of ApiMark.slnx: it exists solely as a
      project-reference target for the SampleLibWithReference fixture (copied and built
      out-of-process by ApiMark.MSBuild.PackageTests), mirroring how the sibling SampleLib*
      fixture projects are also excluded from the main solution.

      GenerateDocumentationFile is true (unlike a bare "false" companion project) specifically
      so that ReferencedLib.xml is emitted alongside ReferencedLib.dll: the auto-harvest test
      (ApiMarkMsbuild_NuGetPackage_DotNetProject_AutoPopulatesReferencePathsFromResolvedReferences)
      needs a real external XML doc file to resolve SampleClass's cross-assembly
      &lt;inheritdoc/&gt; member against, proving the harvested @(ReferencePath) entries are
      actually consumed by ApiMark's cross-assembly inheritdoc resolution rather than merely
      forwarded.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
</Project>
