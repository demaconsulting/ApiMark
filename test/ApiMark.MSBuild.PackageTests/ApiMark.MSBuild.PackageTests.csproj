<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <AssemblyName>ApiMark.MSBuild.PackageTests</AssemblyName>
    <RootNamespace>ApiMark.MSBuild.PackageTests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <!-- Copy fixture files to the test output directory so tests can locate them at runtime.
       Fixture .cs files belong to sample projects built out-of-process by MSBuild during the
       tests, not to this test assembly itself, so they must be excluded from the default
       Compile glob to avoid duplicate-type compile errors between fixture projects that
       intentionally reuse type/namespace names (e.g. SampleLib.SampleClass). -->
  <ItemGroup>
    <Compile Remove="Fixtures\**\*.cs" />
    <Content Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
